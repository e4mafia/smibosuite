{
  "id": "smibosuite",
  "title": "Smibosuite",
  "description": "A small suite of Foundry VTT quality-of-life tools: type in initiative by hand in the Combat Tracker, show a large zoom-independent ruler distance readout, and pan every player's camera to a spot.",
  "version": "1.2.1",
  "socket": true,
  "authors": [
    {
      "name": "Custom"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {
          "minimum": "1.0.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/initiative-editor.js",
    "scripts/ruler-readout.js",
    "scripts/pan-players.js"
  ],
  "styles": [
    "styles/smibosuite.css"
  ],
  "url": "https://github.com/e4mafia/smibosuite",
  "manifest": "https://raw.githubusercontent.com/e4mafia/smibosuite/main/module.json",
  "download": "https://github.com/e4mafia/smibosuite/archive/refs/heads/main.zip",
  "bugs": "https://github.com/e4mafia/smibosuite/issues",
  "readme": "https://github.com/e4mafia/smibosuite/blob/main/README.md",
  "license": "https://github.com/e4mafia/smibosuite/blob/main/LICENSE"
}
